# Copy to .env.local and fill in. Never commit .env.local.

# Gemini (paid key). Used for embeddings, answers, and optional reranking.
GEMINI_API_KEY=

# Supabase. The service-role key bypasses RLS and must stay server-side only —
# it is never referenced from a client component.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Firebase Auth
# ---------------------------------------------------------------------------
# Client-side config (safe to expose to the browser — it identifies the
# project, doesn't grant access to it). Values come from Firebase Console →
# Project settings → Your apps → Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side admin credentials. Generate a service-account key from
# Firebase Console → Project settings → Service accounts → Generate new
# private key. Paste the whole JSON blob on ONE line here (or base64 it).
# Never commit this value anywhere.
FIREBASE_ADMIN_SERVICE_ACCOUNT=

# ---------------------------------------------------------------------------

# Optional: LLM rerank of the fused top 30 down to 6. Costs one extra
# round-trip per question. Measure hit-rate before turning it on.
RERANK=0

# Optional: origin allowed to iframe this app, e.g. https://revibe.training.hub
EMBED_ALLOWED_ORIGIN=
