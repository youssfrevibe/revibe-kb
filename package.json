    "next": "^16.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "comments": {
    "overrides": "unpdf optionally depends on canvas (for rendering PDFs to images, which we never do) which pulls @mapbox/node-pre-gyp -> tar@6. tar@6 carries critical advisories. We cannot omit optional deps wholesale because Next's SWC platform binaries are optional too, so tar is pinned forward instead. If canvas's native build fails as a result, nothing is lost — it is an optional dep we do not use."
  },
  "overrides": {
    "tar": "^7.5.21"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
