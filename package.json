    "start": "next start",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx scripts/ingest.ts",
    "query": "tsx scripts/query.ts",
    "eval": "tsx scripts/eval.ts",
    "seed:threads": "tsx scripts/seed-threads.ts",
