    "mammoth": "^1.8.0",
    "postcss": "^8.5.22",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "unpdf": "^0.12.1",
    "vercel": "^58.9.1"
  }
}
